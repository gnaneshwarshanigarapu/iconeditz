{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "devCommand": "npm run dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{src/**,public/**,dist/**,node_modules/**,backend/tests/**,frontend/**,shared/**,supabase/**,fontawesome-free-6.7.2-web/**,**/__pycache__/**,**/*.py[cod],**/*.map,**/*.log,**/*.md}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
